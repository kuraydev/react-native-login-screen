{
  "name": "react-native-login-screen",
  "version": "6.0.0",
  "description": "Fully Customizable & Ready to use Login Screen for React Native",
  "keywords": [
    "login",
    "sign-up",
    "sign-in",
    "login-screen",
    "screen",
    "kuraydev",
    "react",
    "react-native",
    "typescript",
    "ui-lib",
    "rn"
  ],
  "homepage": "https://github.com/kuraydev/react-native-login-screen#readme",
  "bugs": {
    "url": "https://github.com/kuraydev/react-native-login-screen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraydev/react-native-login-screen.git"
  },
  "author": "Kuray (kuraydev) <kurayogun@gmail.com>",
  "license": "MIT",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__mocks__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.spec.ts",
    "!**/*.spec.tsx"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "del-cli lib",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepare": "husky && bob build",
    "release": "semantic-release"
  },
  "dependencies": {
    "react-native-text-input-interactive": ">=0.1.4 <1.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.9.0",
    "@react-native/babel-preset": "^0.79.0",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.0.8",
    "@types/react-test-renderer": "^18.3.0",
    "del-cli": "^5.1.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.9.0",
    "husky": "^9.0.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.0.2",
    "prettier": "^3.0.0",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-builder-bob": "^0.23.2",
    "react-test-renderer": "18.3.1",
    "semantic-release": "^24.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
